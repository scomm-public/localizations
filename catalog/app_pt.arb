  "encryptedMailboxDatabase": "Proteja os dados da caixa de correio local",
  "@encryptedMailboxDatabase": {
    "x-scomm-source": "machine",
    "x-scomm-en-hash": "16e86eecd4f5d03be38d328eb4c2885d44a27f8c39886a6d5f3b45f433f30eb6"
  },
  "encryptedMailboxDatabaseDescription": "Para {email}: criptografa metadados locais e índices de pesquisa neste dispositivo. O correio no seu provedor permanece inalterado.",
  "encryptedMailboxDatabaseDisableAction": "Descriptografar neste dispositivo",
  "@encryptedMailboxDatabaseDisableAction": {
    "x-scomm-source": "machine",
    "x-scomm-en-hash": "96a90beaa0d6df3301576a36d872d34549e994cd327de4ccb75db4483f311d40"
  },
  "encryptedMailboxDatabaseDisableBody": "Isso se aplica apenas a {email} neste dispositivo.\n\nAviso: o banco de dados local será descriptografado no disco. Qualquer pessoa com acesso a este dispositivo ou a um backup de dados de aplicativos poderá ler metadados de caixas de correio e pesquisar índices até que você os proteja novamente.\n\nReativar a proteção posteriormente executa outra migração completa.\n\nSuas mensagens permanecem no seu provedor de e-mail. Esta caixa de correio será fechada brevemente enquanto os dados são descriptografados.",
  "encryptedMailboxDatabaseDisableTitle": "Parar de proteger os dados locais?",
  "@encryptedMailboxDatabaseDisableTitle": {
    "x-scomm-source": "machine",
    "x-scomm-en-hash": "2aa1fbb726933bcc2fd82c097ff1c91d217a5f93e2649e5ebaa2da984c4a6a92"
  },
  "encryptedMailboxDatabaseDisabled": "Os dados da caixa de correio local não são mais criptografados neste dispositivo.",
  "@encryptedMailboxDatabaseDisabled": {
    "x-scomm-source": "machine",
    "x-scomm-en-hash": "a63a7c00b9e9b730261c3617f364e413800378575dda182fc05a49742b6aab56"
  },
  "encryptedMailboxDatabaseEnableAction": "Proteger",
  "@encryptedMailboxDatabaseEnableAction": {
    "x-scomm-source": "machine",
    "x-scomm-en-hash": "806c20d1d5656602d83acba61b41b5aa42b5301242464d94dc6fefc347a24182"
  },
  "encryptedMailboxDatabaseEnableBody": "Isso se aplica apenas a {email} neste dispositivo.\n\nO que está protegido:\n• Metadados de e-mail locais, rótulos e índices de pesquisa\n• Não são suas mensagens no provedor de e-mail\n\nO que acontece:\n• O banco de dados local é criptografado no disco\n• Uma chave por caixa de correio é armazenada no armazenamento seguro deste dispositivo\n• A abertura e a pesquisa de e-mails podem ser um pouco mais lentas\n• Esta caixa de correio fecha brevemente enquanto os dados são migrados (uma vez)\n\nSe a chave do dispositivo for perdida, o índice local será reconstruído a partir do seu provedor.",
  "encryptedMailboxDatabaseEnableTitle": "Proteger os dados da caixa de correio local?",
